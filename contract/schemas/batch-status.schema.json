{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safehouse.local/contract/0.1/batch-status.schema.json",
  "title": "Batch tool status (status --json)",
  "description": "Printed by a tool without a daemon. A value that is not known is null, never 0.",
  "type": "object",
  "required": ["contract_version", "module", "version", "state", "last_run", "waiting"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": "0.1" },
    "module": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "state": { "enum": ["idle", "running", "waiting", "failed"] },
    "last_run": {
      "type": ["object", "null"],
      "description": "null when the tool has never run",
      "required": ["id", "started", "finished", "outcome", "cost_usd", "record"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "started": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
        "finished": { "type": ["string", "null"], "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
        "outcome": { "enum": ["succeeded", "failed", "waiting", "cancelled", "running"] },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "record": { "type": "string", "minLength": 1, "description": "Path of the last-run record on disk" }
      }
    },
    "waiting": {
      "type": "array",
      "description": "What waits for the user or for a later run, and why",
      "items": {
        "type": "object",
        "required": ["what", "why"],
        "additionalProperties": false,
        "properties": {
          "what": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "count": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "rule_counts": {
      "type": "array",
      "description": "Findings per rule key, UTC day of first sight, severity at creation and current label, over the last 30 UTC days, today included. Printed whenever the tool writes findings, empty when it holds none; one row per rule, day, severity_id and label",
      "items": {
        "type": "object",
        "required": ["rule", "day", "severity_id", "label", "count"],
        "additionalProperties": false,
        "properties": {
          "rule": { "type": "string", "pattern": "^[!#-\\[\\]-~]{1,200}$", "description": "The rule key, finding_info.analytic.uid" },
          "day": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The UTC day the finding was first raised" },
          "severity_id": { "enum": [0, 1, 2, 3, 4, 5, 6, 99], "description": "OCSF severity_id when the finding was raised" },
          "label": { "enum": ["none", "benign", "real", "routine", "test"], "description": "The finding's label now; none when it has none" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
